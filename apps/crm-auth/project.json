{
  "name": "crm-auth",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/crm-auth/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "webpack-cli build",
        "args": ["node-env=production"]
      },
      "configurations": {
        "development": {
          "args": ["node-env=development"]
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "crm-auth:build",
        "runBuildTargetDependencies": false
      },
      "configurations": {
        "development": {
          "buildTarget": "crm-auth:build:development"
        },
        "production": {
          "buildTarget": "crm-auth:build:production"
        }
      }
    },
    "test": {
      "options": {
        "passWithNoTests": true
      }
    },
     "prisma": {
      "command": "prisma",
      "options": {
        "cwd": "apps/crm-auth"
      }
    },
    "migrate": {
      "command": "prisma migrate dev",
      "options": {
        "cwd": "apps/crm-auth"
      }
    },
    "generate-types": {
      "command": "prisma generate",
      "options": {
        "cwd": "apps/crm-auth"
      }
    },
    "prisma-db-seed": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx prisma db seed",
        "cwd": "apps/crm-auth"
      }
    }
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  }
}
